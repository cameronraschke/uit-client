#!/usr/bin/env bash

pngPipe="/tmp/screenshot.$$"
lockFile="/tmp/uit-screenshot.lock"

exec 9>"${lockFile}"
if ! flock -n 9; then
	echo "Another uit-screenshot instance is already running; exiting." >&2
	exit 0
fi

function cleanup {
	rm -f "${pngPipe}"
	pkill -P $$
}
trap 'cleanup' EXIT

function clientLookup() {
	local systemSerial=$(dmidecode --string system-serial-number 2>/dev/null)
	if [[ -z $systemSerial ]]; then
		systemSerial=$(cat /sys/class/dmi/id/product_serial)
	fi
	local tagNum=$(uit-cli --serial "${systemSerial}" --key "client_lookup_by_serial" --value "${systemSerial}" --get | jq -r '.tagnumber' 2>/dev/null)
	while [[ -z $tagNum ]]; do
		echo "Unable to find tag number for system serial ${systemSerial}, retrying in 5 seconds..."
		sleep 5
		tagNum=$(uit-cli --serial "${systemSerial}" --key "client_lookup_by_serial" --value "${systemSerial}" --get | jq -r '.tagnumber' 2>/dev/null)
	done
	echo "${tagNum}"
}

while true; do
	if [[ -e $pngPipe && ! -p $pngPipe ]]; then
		rm -f "${pngPipe}"
	fi
	if [[ ! -p $pngPipe ]]; then
		if ! mkfifo "${pngPipe}"; then
			echo "Failed to create FIFO at ${pngPipe}, retrying in 2 seconds..." >&2
			sleep 2
			continue
		fi
	fi

	tag=$(clientLookup)
	fbgrab - > "${pngPipe}" &
	grabPid=$!
	# printf '%s' "api_post|${tag}|live_image|${pngPipe}" | /opt/uit-toolbox/parse
	uit-cli --tag "${tag}" --key "live_screenshot" --value "${pngPipe}" --post
	wait "${grabPid}" 2>/dev/null || true
	# Update more frequently if a job is active
	if [[ -n $(printf "%s" "api_get|job_name|tagnumber|${tag}" | /opt/uit-toolbox/parse) ]]; then
		sleep 3
	else
		sleep 5
	fi
done